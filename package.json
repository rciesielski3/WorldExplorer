{
  "name": "worldexplorer",
  "license": "0BSD",
  "version": "2.1.0",
  "main": "index.ts",
  "scripts": {
    "countries:generate": "tsx scripts/countries/generate.ts",
    "countries:update": "tsx scripts/countries/update.ts",
    "countries:validate": "tsx scripts/countries/validate.ts",
    "flags:download": "tsx scripts/countries/download-flags.ts",
    "flags:verify": "tsx scripts/countries/verify-flags.ts",
    "firebase:seed": "tsx scripts/firebase/seed-facts.ts",
    "firebase:emulator": "firebase emulators:start",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:node": "node --test screens/quiz/quizSession.test.js",
    "postinstall": "patch-package",
    "prepare": "husky || true",
    "lint": "eslint . --max-warnings=316",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/config-plugins": "~10.1.1",
    "@expo/prebuild-config": "~9.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.17.7",
    "@react-navigation/stack": "^7.1.1",
    "axios": "^1.7.9",
    "dotenv": "^16.5.0",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-modules-core": "~2.5.0",
    "expo-notifications": "~0.31.5",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "firebase": "^12.15.0",
    "i18next": "^24.2.2",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.79.6",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "^15.7.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.13.1",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-toast-message": "^2.2.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@react-native/gradle-plugin": "0.79.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.0.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "firebase-admin": "^14.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-environment-node": "^29.5.0",
    "lint-staged": "^17.6.2",
    "patch-package": "^8.0.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "19.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-maps"
        ]
      },
      "android": {
        "permissions": [
          "ACCESS_FINE_LOCATION",
          "ACCESS_COARSE_LOCATION"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
