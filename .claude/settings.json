{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm run countries:validate)",
      "Bash(npm run flags:verify)",
      "Bash(npx jest *)",
      "Bash(npx tsc *)",
      "Bash(gh run *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gitleaks *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.production)",
      "Bash(cat *.env.development)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(head *.env.production)",
      "Bash(head *.env.development)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)",
      "Bash(tail *.env.production)",
      "Bash(tail *.env.development)",
      "Bash(less *.env)",
      "Bash(less *.env.local)",
      "Bash(less *.env.production)",
      "Bash(less *.env.development)",
      "Bash(grep *.env)",
      "Bash(grep *.env.local)",
      "Bash(grep *.env.production)",
      "Bash(grep *.env.development)",
      "Bash(sed *.env)",
      "Bash(sed *.env.local)",
      "Bash(sed *.env.production)",
      "Bash(sed *.env.development)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tsc-check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
